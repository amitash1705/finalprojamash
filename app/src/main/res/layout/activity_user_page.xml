<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".UserPageActivity">

    <!-- Title -->
    <TextView
        android:id="@+id/textView6"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="User Page"
        android:textSize="34sp"
        android:textStyle="bold"
        android:textColor="#111111"
        android:fontFamily="@font/mimosa"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="60dp"/>

    <!-- My Trips -->
    <Button
        android:id="@+id/button2"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:text="My Trips"
        android:textSize="16sp"
        android:textColor="#111111"
        android:backgroundTint="#EEEEEE"
        android:fontFamily="@font/mimosa"
        android:onClick="goMyTravels"
        app:cornerRadius="18dp"
        app:layout_constraintTop_toBottomOf="@id/textView6"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="40dp"
        android:layout_marginHorizontal="32dp"/>

    <!-- Add Trip -->
    <Button
        android:id="@+id/button"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:text="Add New Trip"
        android:textSize="16sp"
        android:textColor="#111111"
        android:backgroundTint="#EEEEEE"
        android:fontFamily="@font/mimosa"
        android:onClick="goNewTravel"
        app:cornerRadius="18dp"
        app:layout_constraintTop_toBottomOf="@id/button2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"
        android:layout_marginHorizontal="32dp"/>

    <!-- Profile -->
    <Button
        android:id="@+id/btnpro"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:text="Profile"
        android:textSize="16sp"
        android:textColor="#111111"
        android:backgroundTint="#EEEEEE"
        android:fontFamily="@font/mimosa"
        android:onClick="openProfile"
        app:cornerRadius="18dp"
        app:layout_constraintTop_toBottomOf="@id/button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"
        android:layout_marginHorizontal="32dp"/>

    <!-- Attractions -->
    <Button
        android:id="@+id/btnAddNewAttraction"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:text="Attractions"
        android:textSize="16sp"
        android:textColor="#111111"
        android:backgroundTint="#EEEEEE"
        android:fontFamily="@font/mimosa"
        android:onClick="goAddAttraction"
        app:cornerRadius="18dp"
        app:layout_constraintTop_toBottomOf="@id/btnpro"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"
        android:layout_marginHorizontal="32dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>