<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F9FC"
    tools:context=".Travelprofileamash">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/backamash"
        android:scaleType="centerCrop"/>


    <!-- Title -->
    <TextView
        android:id="@+id/tvtravelprofile"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Travel Profile"
        android:textSize="40sp"
        android:textStyle="bold"
        android:textColor="#111111"
        android:fontFamily="@font/mimosa"
        android:layout_marginTop="40dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Name -->
    <EditText
        android:id="@+id/ettravelnameprofile"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginTop="24dp"
        android:layout_marginHorizontal="32dp"
        android:background="#FFFFFF"
        android:padding="12dp"
        android:hint="Travel Name"
        android:textSize="20sp"
        android:fontFamily="@font/mimosa"
        app:layout_constraintTop_toBottomOf="@id/tvtravelprofile"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Details -->
    <EditText
        android:id="@+id/ettraveldetailsprofile"
        android:layout_width="0dp"
        android:layout_height="100dp"
        android:layout_marginTop="16dp"
        android:layout_marginHorizontal="32dp"
        android:background="#FFFFFF"
        android:padding="12dp"
        android:hint="Travel Details"
        android:textSize="20sp"
        android:fontFamily="@font/mimosa"
        app:layout_constraintTop_toBottomOf="@id/ettravelnameprofile"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Recycler Title -->
    <TextView
        android:id="@+id/tvAttractionsProfile"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Attractions"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#333333"
        android:fontFamily="@font/mimosa"
        android:layout_marginTop="20dp"
        android:layout_marginStart="32dp"
        app:layout_constraintTop_toBottomOf="@id/ettraveldetailsprofile"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- Recycler -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvtravelAttractionProfile2"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_marginHorizontal="16dp"
        android:clipToPadding="false"
        android:padding="8dp"
        app:layout_constraintTop_toBottomOf="@id/tvAttractionsProfile"
        app:layout_constraintBottom_toTopOf="@id/btneditAttractions"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- NEW BUTTON: Edit Attractions -->
    <Button
        android:id="@+id/btneditAttractions"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:text="Add Attractions"
        android:textSize="20sp"
        android:backgroundTint="#111111"
        android:textColor="#FFFFFF"
        android:fontFamily="@font/mimosa"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="12dp"
        app:cornerRadius="20dp"
        app:layout_constraintBottom_toTopOf="@id/btnsaveedittravelprofile"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Save Button -->
    <Button
        android:id="@+id/btnsaveedittravelprofile"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:text="Save Changes"
        android:textSize="20sp"
        android:textColor="#FFFFFF"
        android:fontFamily="@font/mimosa"
        android:backgroundTint="#111111"
        app:cornerRadius="20dp"
        android:layout_margin="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>