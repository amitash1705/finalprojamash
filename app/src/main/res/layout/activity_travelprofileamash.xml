<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Travelprofileamash">

    <TextView
        android:id="@+id/tvtravelprofile"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TextView"
        tools:layout_editor_absoluteX="165dp"
        tools:layout_editor_absoluteY="27dp" />

    <TextView
        android:id="@+id/tvtravelnameprofile"
        android:layout_width="92dp"
        android:layout_height="26dp"
        android:text="TextView"
        tools:layout_editor_absoluteX="255dp"
        tools:layout_editor_absoluteY="66dp" />

    <EditText
        android:id="@+id/ettraveldetailsprofile"
        android:layout_width="346dp"
        android:layout_height="44dp"
        android:ems="10"
        android:inputType="text"
        android:text="Name"
        tools:layout_editor_absoluteX="44dp"
        tools:layout_editor_absoluteY="105dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvtravelprofile"
        android:layout_width="411dp"
        android:layout_height="465dp"
        tools:layout_editor_absoluteX="-1dp"
        tools:layout_editor_absoluteY="150dp" />

    <Button
        android:id="@+id/btnsaveedittravelprofile"
        android:layout_width="120dp"
        android:layout_height="70dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="24dp"
        android:backgroundTint="#322196F3"
        android:fontFamily="@font/mimosa"
        android:text="Button"
        android:textColor="@color/black"
        android:textSize="25dp"
        app:cornerRadius="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/btnbacktravelprofile"
        android:layout_width="120dp"
        android:layout_height="70dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="146dp"
        android:layout_marginBottom="24dp"
        android:backgroundTint="#322196F3"
        android:fontFamily="@font/mimosa"
        android:text="Edit"
        android:textColor="@color/black"
        android:textSize="25dp"
        app:cornerRadius="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btnsaveedittravelprofile"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>