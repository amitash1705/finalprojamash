<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- Background (עדין ונקי במקום כחול כבד) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#F7F9FC"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/tvhomepage"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Title -->
    <TextView
        android:id="@+id/tvhomepage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Home Page"
        android:textSize="34sp"
        android:textStyle="bold"
        android:textColor="#111111"
        android:letterSpacing="0.05"
        android:fontFamily="@font/mimosa"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/ivpic"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="60dp"/>

    <!-- Image -->
    <ImageView
        android:id="@+id/ivpic"
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:scaleType="centerInside"
        android:src="@drawable/logo2amash"
        app:layout_constraintTop_toBottomOf="@id/tvhomepage"
        app:layout_constraintBottom_toTopOf="@id/btnconect"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp"/>

    <!-- Login -->
    <Button
        android:id="@+id/btnconect"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:text="Login"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:fontFamily="@font/mimosa"
        android:backgroundTint="#111111"
        app:cornerRadius="16dp"
        app:layout_constraintTop_toBottomOf="@id/ivpic"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="40dp"
        android:layout_marginHorizontal="32dp"/>

    <!-- Sign Up -->
    <Button
        android:id="@+id/btnsigh"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:text="Sign Up"
        android:textColor="#111111"
        android:textSize="16sp"
        android:fontFamily="@font/mimosa"
        android:backgroundTint="#EAEAEA"
        app:cornerRadius="16dp"
        app:layout_constraintTop_toBottomOf="@id/btnconect"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"
        android:layout_marginHorizontal="32dp"/>

    <!-- About -->
    <Button
        android:id="@+id/btnodot"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:text="About"
        android:textColor="#666666"
        android:textSize="15sp"
        android:fontFamily="@font/mimosa"
        android:backgroundTint="#F2F2F2"
        app:cornerRadius="16dp"
        app:layout_constraintTop_toBottomOf="@id/btnsigh"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"
        android:layout_marginHorizontal="32dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>