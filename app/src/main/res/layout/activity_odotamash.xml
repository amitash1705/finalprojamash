<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".odotamash">

    <!-- Title -->
    <TextView
        android:id="@+id/textView3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="About"
        android:textSize="40sp"
        android:textStyle="bold"
        android:textColor="#111111"
        android:fontFamily="@font/mimosa"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="56dp"/>

    <!-- Card container -->
    <LinearLayout
        android:id="@+id/aboutCard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:background="#F5F5F5"
        android:padding="20dp"
        app:layout_constraintTop_toBottomOf="@id/textView3"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="24dp"
        android:layout_marginHorizontal="20dp">

        <!-- Intro text -->
        <TextView
            android:id="@+id/textView4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ברוכים הבאים ל־Travely אפליקציה חכמה ופשוטה שמלווה אתכם בתכנון הטיול ושמירת הזיכרונות לאורך הדרך.\n\nתוכלו להוסיף תמונות ולשמור רגעים מיוחדים מכל שלב במסע שלכם.\n\nTravely מרכזת במקום אחד את כל נתוני הטיול שבחרתם, כדי לייצר חוויה אישית ומדויקת."
            android:textSize="15sp"
            android:textColor="#333333"
            android:lineSpacingExtra="6dp"
            android:fontFamily="@font/mimosa"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"/>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#DDDDDD"
            android:layout_marginBottom="16dp"/>

        <!-- Guide text -->
        <TextView
            android:id="@+id/textView2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="מדריך למשתמש:\n\nהרשמה: כדי להשתמש באפליקציה ולשמור את המידע שלכם, התחילו ביצירת חשבון חדש. לחצו על הרשמה ומלאו את הפרטים הנדרשים.\n\nלאחר ההרשמה תוכלו להיכנס בכל עת לפרופיל שלכם דרך כפתור ההתחברות.\n\nהתחברות: אם כבר יש לכם חשבון, לחיצה על התחברות תאפשר לכם לגשת לפרופיל הקיים שלכם.\n\nכאן תוכלו לראות את כל המידע שהזנתם: טיולים שהושלמו, אטרקציות שיצרתם, תמונות וזיכרונות נוספים.\n\nבנוסף, תוכלו לעדכן ולנהל את הנתונים שלכם בקלות, כשהכל נשמר ונגיש בכל זמן.\n\nלאחר כניסה לפרופיל תוכלו להשתמש באפליקציה: ליצור טיולים חדשים, אטרקציות ולראות טיולים שכבר הוזנו."
            android:textSize="14sp"
            android:textColor="#444444"
            android:lineSpacingExtra="6dp"
            android:fontFamily="@font/mimosa"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>