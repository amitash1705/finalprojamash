<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Editattraction">

    <!-- Title -->
    <TextView
        android:id="@+id/Editattraction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Edit Attraction"
        android:textSize="40sp"
        android:textStyle="bold"
        android:textColor="#111111"
        android:fontFamily="@font/mimosa"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="32dp"/>

    <!-- Country -->
    <TextView
        android:id="@+id/editcountry"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pick a country"
        android:textSize="14sp"
        android:textColor="#666666"
        app:layout_constraintTop_toBottomOf="@id/Editattraction"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="32dp"
        android:layout_marginTop="24dp"/>

    <Spinner
        android:id="@+id/speditCountry"
        android:layout_width="0dp"
        android:layout_height="48dp"
        app:layout_constraintTop_toBottomOf="@id/editcountry"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginHorizontal="32dp"
        android:layout_marginTop="8dp"/>

    <!-- Type -->
    <TextView
        android:id="@+id/editpickattraction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pick type of attraction"
        android:textSize="14sp"
        android:textColor="#666666"
        app:layout_constraintTop_toBottomOf="@id/speditCountry"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="32dp"
        android:layout_marginTop="16dp"/>

    <Spinner
        android:id="@+id/speditType"
        android:layout_width="0dp"
        android:layout_height="48dp"
        app:layout_constraintTop_toBottomOf="@id/editpickattraction"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginHorizontal="32dp"
        android:layout_marginTop="8dp"/>

    <!-- Row: Name / Price / Age -->
    <EditText
        android:id="@+id/editName"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:hint="Name"
        android:background="#F3F3F3"
        android:padding="10dp"
        app:layout_constraintTop_toBottomOf="@id/speditType"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/editPrice"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="12dp"/>

    <EditText
        android:id="@+id/editPrice"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:hint="Price"
        android:background="#F3F3F3"
        android:padding="10dp"
        app:layout_constraintTop_toTopOf="@id/editName"
        app:layout_constraintStart_toEndOf="@id/editName"
        app:layout_constraintEnd_toStartOf="@id/editAge"
        android:layout_marginEnd="8dp"/>

    <EditText
        android:id="@+id/editAge"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:hint="Age"
        android:background="#F3F3F3"
        android:padding="10dp"
        app:layout_constraintTop_toTopOf="@id/editName"
        app:layout_constraintStart_toEndOf="@id/editPrice"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="32dp"/>

    <!-- Details -->
    <EditText
        android:id="@+id/editDetails"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:hint="Details"
        android:background="#F3F3F3"
        android:padding="10dp"
        app:layout_constraintTop_toBottomOf="@id/editName"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginHorizontal="32dp"
        android:layout_marginTop="8dp"/>

    <!-- Address -->
    <EditText
        android:id="@+id/editAdress"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:hint="Address"
        android:background="#F3F3F3"
        android:padding="10dp"
        app:layout_constraintTop_toBottomOf="@id/editDetails"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/editCity"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="8dp"/>

    <!-- City -->
    <EditText
        android:id="@+id/editCity"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:hint="City"
        android:background="#F3F3F3"
        android:padding="10dp"
        app:layout_constraintTop_toTopOf="@id/editAdress"
        app:layout_constraintStart_toEndOf="@id/editAdress"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="32dp"/>

    <!-- Web -->
    <EditText
        android:id="@+id/editWeb"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:hint="Website"
        android:background="#F3F3F3"
        android:padding="10dp"
        app:layout_constraintTop_toBottomOf="@id/editAdress"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginHorizontal="32dp"
        android:layout_marginTop="8dp"/>

    <!-- Image -->
    <ImageView
        android:id="@+id/imageView3"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:background="#EEEEEE"
        app:layout_constraintTop_toBottomOf="@id/editWeb"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="32dp"
        android:layout_marginTop="16dp"/>

    <!-- Gallery -->
    <Button
        android:id="@+id/btneditGallery"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:text="Gallery"
        android:textColor="#111111"
        android:backgroundTint="#EDEDED"
        app:layout_constraintTop_toTopOf="@id/imageView3"
        app:layout_constraintStart_toEndOf="@id/imageView3"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="12dp"/>

    <!-- Photo -->
    <Button
        android:id="@+id/btneditPhoto"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:text="Photo"
        android:textColor="#111111"
        android:backgroundTint="#EDEDED"
        app:layout_constraintTop_toBottomOf="@id/btneditGallery"
        app:layout_constraintStart_toStartOf="@id/btneditGallery"
        app:layout_constraintEnd_toEndOf="@id/btneditGallery"
        android:layout_marginTop="8dp"/>

    <!-- Save -->
    <Button
        android:id="@+id/btneditAttraction"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:text="Edit Attraction"
        android:textColor="#FFFFFF"
        android:backgroundTint="#111111"
        app:layout_constraintTop_toBottomOf="@id/imageView3"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginHorizontal="32dp"
        android:layout_marginTop="24dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>