<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".AdminActivityamash">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/backamash"
        android:scaleType="centerCrop"/>

    <!-- Title -->
    <TextView
        android:id="@+id/textView8"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Admin Page"
        android:textSize="40sp"
        android:textStyle="bold"
        android:textColor="#111111"
        android:fontFamily="@font/mimosa"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="72dp"/>

    <!-- Users -->
    <Button
        android:id="@+id/btnUsers"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:text="Users List"
        android:textSize="20sp"
        android:textColor="#111111"
        android:backgroundTint="#EEEEEE"
        android:fontFamily="@font/mimosa"
        app:cornerRadius="16dp"
        app:layout_constraintTop_toBottomOf="@id/textView8"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="48dp"
        android:layout_marginHorizontal="32dp"/>

    <!-- Profile -->
    <Button
        android:id="@+id/btnpro"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:text="Profile"
        android:textSize="20sp"
        android:textColor="#111111"
        android:backgroundTint="#EEEEEE"
        android:fontFamily="@font/mimosa"
        app:cornerRadius="16dp"
        app:layout_constraintTop_toBottomOf="@id/btnUsers"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp"
        android:layout_marginHorizontal="32dp"/>

    <!-- Attractions -->
    <Button
        android:id="@+id/btnAttractions"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:text="Attractions List"
        android:textSize="20sp"
        android:textColor="#111111"
        android:backgroundTint="#EEEEEE"
        android:fontFamily="@font/mimosa"
        app:cornerRadius="16dp"
        app:layout_constraintTop_toBottomOf="@id/btnpro"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp"
        android:layout_marginHorizontal="32dp"/>

    <!-- Trips -->
    <Button
        android:id="@+id/btnTrips"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:text="Trips List"
        android:textSize="20sp"
        android:textColor="#111111"
        android:backgroundTint="#EEEEEE"
        android:fontFamily="@font/mimosa"
        app:cornerRadius="16dp"
        app:layout_constraintTop_toBottomOf="@id/btnAttractions"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp"
        android:layout_marginHorizontal="32dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>